/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM14_Init();
  /* USER CODE BEGIN 2 */
  HAL_GPIO_WritePin(SEG0_GPIO_Port, SEG0_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG1_GPIO_Port, SEG1_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG2_GPIO_Port, SEG2_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG3_GPIO_Port, SEG3_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG4_GPIO_Port, SEG4_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG5_GPIO_Port, SEG5_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(SEG6_GPIO_Port, SEG6_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(DIG0_GPIO_Port, DIG0_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(DIG1_GPIO_Port, DIG1_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(RELAY_GPIO_Port, RELAY_Pin, GPIO_PIN_RESET);

  generalCounter = 60;

  Digit7Seg_t Digit0 = DIGIT_6;
  Digit7Seg_t Digit1 = DIGIT_0;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN 3 */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (second)
	  {
		  second = 0;
	  }

	  if(digitInUse)
	  {
		  HAL_GPIO_WritePin(DIG0_GPIO_Port, DIG0_Pin, GPIO_PIN_RESET);
		  HAL_GPIO_WritePin(DIG1_GPIO_Port, DIG1_Pin, GPIO_PIN_RESET);

		  printDigit7Seg(Digit0);

		  HAL_GPIO_WritePin(DIG0_GPIO_Port, DIG0_Pin, GPIO_PIN_SET);
		  HAL_GPIO_WritePin(DIG1_GPIO_Port, DIG1_Pin, GPIO_PIN_RESET);

		  digitInUse = 0;
	  }
	  else
	  {
		  HAL_GPIO_WritePin(DIG0_GPIO_Port, DIG0_Pin, GPIO_PIN_RESET);
		  HAL_GPIO_WritePin(DIG1_GPIO_Port, DIG1_Pin, GPIO_PIN_RESET);

		  printDigit7Seg(Digit1);

		  HAL_GPIO_WritePin(DIG0_GPIO_Port, DIG0_Pin, GPIO_PIN_RESET);
		  HAL_GPIO_WritePin(DIG1_GPIO_Port, DIG1_Pin, GPIO_PIN_SET);

		  digitInUse = 1;
	  }

	  if(GPIO_PIN_SET == HAL_GPIO_ReadPin(BUTTON_GPIO_Port, BUTTON_Pin))
	  {
		  buttonReleaseCounter = 0;

		  if(buttonPressCounter > BUTTON_DEBOUNCE)
		  {
			  buttonStatus = 1;
		  }
		  else{++buttonPressCounter;}
	  }
	  else
	  {
		  buttonPressCounter = 0;

		  if(buttonReleaseCounter > BUTTON_DEBOUNCE)
		  {
			  buttonStatus = 0;
		  }
		  else{++buttonReleaseCounter;}
	  }

	  if(buttonStatus != buttonPrevStatus)
	  {
		  buttonPrevStatus = buttonStatus;
		  buttonStatusChanged = 1;
	  }
	  else{buttonStatusChanged = 0;}

	  switch(state)
	  {
	  	  case 0:
	  	  {
	  		  if(buttonStatusChanged && buttonStatus)
	  		  {
	  			  Digit0 = DIGIT_6;
	  			  Digit1 = DIGIT_0;

	  			  HAL_GPIO_WritePin(RELAY_GPIO_Port, RELAY_Pin, GPIO_PIN_RESET);

	  			  Timer_Stop();

	  			  state = 1;
	  		  }
	  	  }
	  	  break;

	  	  case 1:
	  	  {
	  		  Timer_Start();
	  		  state = 2;
	  	  }
	  	  break;

	  	  case 2:
	  	  {

	  		state = 3;
	  	  }
	  	  break;

	  	  case 3:
	  	  {
	  		  if(buttonStatusChanged && buttonStatus){state = 4;}
	  	  }
	  	  break;

	  	  case 4:
	  	  {
	  		Timer_Stop();
	  		state = 5;
	  	  }
	  	  break;

	  	  case 5:
	  	  {

	  	  }
	  	  break;
	  }
  }
  /* USER CODE END WHILE */
  /* USER CODE END 3 */
}

